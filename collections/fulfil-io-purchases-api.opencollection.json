{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fulfil REST API (v2) Authentication Purchases API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Purchases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search purchase orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{merchant_id}.fulfil.io/api/v2/model/purchase.purchase",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "A Fulfil domain filter (JSON-encoded list of clauses)."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to return."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records per page."
              }
            ]
          },
          "docs": "Searches purchase orders (purchase.purchase)."
        },
        {
          "info": {
            "name": "Create purchase orders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{merchant_id}.fulfil.io/api/v2/model/purchase.purchase",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates one or more purchase orders (purchase.purchase)."
        }
      ]
    }
  ],
  "bundled": true
}